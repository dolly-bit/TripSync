# Database Configuration
DB_URL=jdbc:mysql://mysql:3306/tripsync_db
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password

# JWT Configuration (Base64-encoded 256-bit secret)
JWT_SECRET=your_base64_encoded_256_bit_jwt_secret

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# Admin Bootstrap Configuration
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_EMAIL=admin@tripsync.com
ADMIN_BOOTSTRAP_PASSWORD=Admin@123456
ADMIN_BOOTSTRAP_FULL_NAME=TripSync Admin

# Email Configuration (Resend)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Application Configuration
PORT=8080
APP_BASE_URL=http://localhost:3000
DOCUMENT_STORAGE_DIR=uploads/documents
DOCUMENT_MAX_SIZE_BYTES=10485760
